# Copy this file to .env and configure your environment

# For local MongoDB (Docker/Podman) - Development
MONGODB_URI=mongodb://localhost:27017
PORT=3000

# For MongoDB Atlas - Production
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/m7_frontend?retryWrites=true&w=majority
# PORT=3000

# Google Books API Key
# Get your API key from: https://developers.google.com/books/docs/v1/using
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
